# Copy to .env for local testing with `docker compose` (not `stack deploy`,
# which ignores .env and reads secrets from `docker secret create` instead).

OIDC_ISSUER=https://authentik.example.com/application/o/container-kicker/
OIDC_CLIENT_ID=container-kicker
OIDC_CLIENT_SECRET=changeme
PUBLIC_URL=http://localhost:8088
OIDC_CALLBACK_PATH=/auth/callback

SESSION_SECRET=changeme-too
COOKIE_SECURE=false
TRUST_PROXY=false

PORT=8088

# Leave OIDC_ISSUER/OIDC_CLIENT_ID/OIDC_CLIENT_SECRET unset to run with no
# auth at all (fine for local testing, NOT for anything reachable by others).
#
# OIDC_CLIENT_ID and OIDC_CLIENT_SECRET also accept the _FILE convention
# (OIDC_CLIENT_ID_FILE=/path/to/file) if you'd rather test that path locally.
